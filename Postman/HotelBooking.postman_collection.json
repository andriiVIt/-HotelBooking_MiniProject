	"item": [
		{
			"name": "Create booking",
			"item": [
				{
					"name": "TC1 - Booking succeeds",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"TC1: Booking is created (status 201)\", function () {\r",
									"    pm.response.to.have.status(201);\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Dates relative to today (local time), so the test never gets outdated\r",
									"function addDays(days) {\r",
									"    const d = new Date();\r",
									"    d.setDate(d.getDate() + days);\r",
									"    const mm = String(d.getMonth() + 1).padStart(2, \"0\");\r",
									"    const dd = String(d.getDate()).padStart(2, \"0\");\r",
									"    return `${d.getFullYear()}-${mm}-${dd}`;\r",
									"}\r",
									"\r",
									"// TC1: SD and ED both before the fully occupied range (B-B)\r",
									"pm.variables.set(\"startDate\", addDays(1));\r",
									"pm.variables.set(\"endDate\", addDays(3));"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"protocolProfileBehavior": {
						"disabledSystemHeaders": {}
					},
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"startDate\": \"{{startDate}}\",\n  \"endDate\": \"{{endDate}}\",\n  \"customerId\": 1\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "https://localhost:5001/Bookings",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "5001",
							"path": [
								"Bookings"
							]
						}
					},
					"response": []
				},
				{
					"name": "TC4 - Booking fails",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Dates relative to today (local time), so the test never gets outdated\r",
									"function addDays(days) {\r",
									"    const d = new Date();\r",
									"    d.setDate(d.getDate() + days);\r",
									"    const mm = String(d.getMonth() + 1).padStart(2, \"0\");\r",
									"    const dd = String(d.getDate()).padStart(2, \"0\");\r",
									"    return `${d.getFullYear()}-${mm}-${dd}`;\r",
									"}\r",
									"\r",
									"// TC4: SD before, ED on the first day of the fully occupied range (B-O)\r",
									"pm.variables.set(\"startDate\", addDays(3));\r",
									"pm.variables.set(\"endDate\", addDays(4));"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"TC4: Booking is rejected (status 409)\", function () {\r",
									"    pm.response.to.have.status(409);\r",
									"});\r",
									"\r",
									"pm.test(\"Response explains that all rooms are occupied\", function () {\r",
									"    pm.expect(pm.response.text()).to.include(\"All rooms are occupied\");\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n  \"startDate\": \"{{startDate}}\",\r\n  \"endDate\": \"{{endDate}}\",\r\n  \"customerId\": 1\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "https://localhost:5001/Bookings",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "5001",
							"path": [
								"Bookings"
							]
						}
					},
					"response": []
				}
			]
		},
